PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/internship_assignment
# Production → use MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/internship_assignment?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# Comma-separated list — add your Vercel URL after the comma:
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app
